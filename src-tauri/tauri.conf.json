{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Riekko Tunnel",
  "version": "0.1.0",
  "identifier": "com.riekko.tunnel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Riekko Tunnel",
        "width": 1080,
        "height": 700,
        "minWidth": 860,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/xray", "binaries/hysteria", "binaries/tun2socks"],
    "resources": {
      "binaries/wintun.dll": "wintun.dll"
    }
  }
}
